---
---
<header class="sticky top-0 z-50 bg-[#FAF9F6]/90 backdrop-blur-md border-b border-slate-200/60 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-full bg-[#02529C] text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-[#02529C] transition-colors">OIA LENS</span>
        <span class="block text-[10px] tracking-widest uppercase text-slate-400 font-semibold">Santorini GPS Guide</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class="text-sm font-medium text-slate-600 hover:text-[#02529C] transition-colors">Home</a>
      <a href="/the-journal" class="text-sm font-medium text-slate-600 hover:text-[#02529C] transition-colors">The Journal</a>
      <a href="/#features" class="text-sm font-medium text-slate-600 hover:text-[#02529C] transition-colors">How It Works</a>
      <a href="/#about" class="text-sm font-medium text-slate-600 hover:text-[#02529C] transition-colors">About</a>
    </nav>

    <!-- Web App CTA -->
    <div class="flex items-center gap-4">
      <a 
        href="https://app.oialens.com/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#02529C] hover:bg-[#013f78] text-white font-medium text-sm shadow-md shadow-blue-900/10 hover:shadow-lg transition-all"
      >
        <span>Get the Map</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
