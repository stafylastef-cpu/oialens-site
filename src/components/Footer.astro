---
---
<footer class="bg-slate-900 text-slate-300 mt-auto border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Col 1: Brand & Mission -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-[#02529C] text-white flex items-center justify-center font-bold text-sm">
            OL
          </div>
          <span class="text-xl font-bold tracking-tight text-white">OIA LENS</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          The first interactive guide and GPS photo map designed for travelers and creators in Oia, Santorini. Exact stand precision, optimal light timing, and zero clutter.
        </p>
        <p class="mt-4 text-xs text-slate-500">
          Contact: <a href="mailto:hello@oialens.com" class="text-blue-400 hover:underline">hello@oialens.com</a>
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Explore</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/the-journal" class="hover:text-white transition-colors">The Journal (Santorini Guides)</a></li>
          <li><a href="https://app.oialens.com/" target="_blank" rel="noopener" class="hover:text-white transition-colors">Interactive Web App</a></li>
          <li><a href="/#about" class="hover:text-white transition-colors">About Oia Lens</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact & Newsletter Form -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Get in Touch</h4>
        <form class="space-y-3" onsubmit="event.preventDefault(); alert('Thank you for contacting Oia Lens! We will reply shortly.');">
          <input 
            type="text" 
            placeholder="Your name" 
            required 
            class="w-full px-3.5 py-2 text-sm rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#02529C]"
          />
          <input 
            type="email" 
            placeholder="Your email address" 
            required 
            class="w-full px-3.5 py-2 text-sm rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#02529C]"
          />
          <textarea 
            placeholder="Your message" 
            rows="2" 
            required 
            class="w-full px-3.5 py-2 text-sm rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#02529C]"
          ></textarea>
          <button 
            type="submit" 
            class="w-full py-2.5 px-4 rounded-lg bg-[#02529C] hover:bg-blue-600 text-white text-sm font-medium transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {new Date().getFullYear()} Oia Lens. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="https://app.oialens.com/" target="_blank" rel="noopener" class="hover:text-slate-400 transition-colors">Terms & Liability Disclaimer</a>
        <span>·</span>
        <span>Public Paths Only · Respect Local Residents</span>
      </div>
    </div>
  </div>
</footer>
